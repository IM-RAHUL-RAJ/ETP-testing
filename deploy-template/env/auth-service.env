# auth-service's own settings (not secret). Same use as common.env:
#   kubectl -n $PROJECT create configmap auth-service-config --from-env-file=deploy/env/auth-service.env
#
# CHANGE ME: the names your auth-service reads. Typical NestJS names are below; rename them
# to match your code (for example DATABASE_HOST instead of DB_HOST, or PGHOST).
PORT=3000
JWT_ISSUER=auth-service
JWT_EXPIRES_IN=900
# The page's address, for CORS. On the box: http://<EC2 public IP>:4200.
CORS_ALLOWED_ORIGINS=http://localhost:4200
