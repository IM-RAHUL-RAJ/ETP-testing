# executor-service's own settings (not secret).
#   kubectl -n $PROJECT create configmap executor-service-config --from-env-file=deploy/env/executor-service.env
#
# CHANGE ME: the names your executor-service reads.
SERVER_PORT=8082
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/trading
SPRING_DATASOURCE_USERNAME=postgres
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
