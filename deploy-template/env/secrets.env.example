# Copy to deploy/env/secrets.env and fill in. NEVER commit secrets.env (it is in .gitignore).
#   cp deploy/env/secrets.env.example deploy/env/secrets.env
# Docker compose loads it into every service; Kubernetes gets it as a Secret (README step 9):
#   kubectl -n $PROJECT create secret generic app-secrets --from-env-file=deploy/env/secrets.env
#
# Make up the passwords and keys yourself:
#   openssl rand -hex 32        a password or a JWT secret (HS256 needs at least 32 bytes)
#   openssl rand -base64 32     an encryption key read as base64 of 32 bytes
#
# CHANGE ME: the secret names your code reads (DB password, JWT secret, API keys, mail login).
DB_PASSWORD=change-me
POSTGRES_PASSWORD=change-me
SPRING_DATASOURCE_PASSWORD=change-me
JWT_SECRET=change-me-run-openssl-rand-hex-32
FAUXNANCE_API_KEY=
