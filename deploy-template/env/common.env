# Settings every service reads. Docker compose loads this file into each service, and
# Kubernetes gets the same values from it (README step 9):
#   kubectl -n $PROJECT create configmap common-config --from-env-file=deploy/env/common.env
#
# CHANGE ME: use the names YOUR code reads. Open each service's application.yml /
# application.properties / config.ts and look for ${SOMETHING} or process.env.SOMETHING.
# Every name it needs without a default must be set here or in the service's own file.
#
# On the box these names are the containers; on EKS they are the Services. Same names, so
# this file works in both. For RDS change DB_HOST to the RDS endpoint.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=trading
DB_USER=postgres
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
AUTH_SERVICE_URL=http://auth-service:3000
ORDER_SERVICE_URL=http://order-service:8081
EXECUTOR_SERVICE_URL=http://executor-service:8082
FAUXNANCE_BASE_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com/v1
