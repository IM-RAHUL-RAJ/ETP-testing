# order-service's own settings (not secret).
#   kubectl -n $PROJECT create configmap order-service-config --from-env-file=deploy/env/order-service.env
#
# CHANGE ME: the names your order-service reads. Spring maps SPRING_DATASOURCE_URL to
# spring.datasource.url and so on; a ${NAME} in application.yml needs NAME here.
SERVER_PORT=8081
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/trading
SPRING_DATASOURCE_USERNAME=postgres
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200
