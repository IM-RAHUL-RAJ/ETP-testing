# Copy to deploy/.env, fill in and COMMIT it (no secrets here; Jenkins reads it too):
#   cp deploy/.env.example deploy/.env
# docker compose reads this file (run compose from the deploy/ folder). Secrets go in env/secrets.env.

# ---- CHANGE ME: your project ----
# Lower case, no spaces: used for image names and the Kubernetes namespace.
PROJECT=se1-team1
# What people type in the browser: http://<EC2 public IP>:4200 on the box.
PUBLIC_URL=http://localhost:4200

# ---- CHANGE ME: where each service lives in your repository ----
FRONTEND_DIR=Frontend/trading-ui
AUTH_DIR=Services/auth-service
ORDER_DIR=Services/order-service
EXECUTOR_DIR=Services/executor-service
# The file your auth-service build writes (look in its dist/ folder after npm run build).
AUTH_ENTRY=dist/main.js

# ---- CHANGE ME: your SQL (loaded in this order into an empty database) ----
SQL_DIR=../Databases/PostgreSQL
SQL_FILES=schema.sql seed-data.sql

# ---- Database ----
# localdb starts a Postgres container. For RDS: COMPOSE_PROFILES= (empty) and
# DB_HOST=<RDS endpoint> in env/common.env.
COMPOSE_PROFILES=localdb
DB_NAME=trading
DB_USER=postgres

# ---- Kafka topics your services use (name:partitions) ----
KAFKA_TOPICS=orders:3 trade-events:3 market-data:3
