# ---- Build stage ----
FROM maven:3.9.9-eclipse-temurin-21 AS builder

WORKDIR /app

# Copy pom.xml first to cache dependency resolution layer
COPY pom.xml .
RUN mvn dependency:go-offline -q

# Copy source and build
COPY src ./src
RUN mvn package -DskipTests -q

# ---- Runtime stage ----
FROM eclipse-temurin:21-jre-alpine AS runtime

# Create a non-root user and group
RUN addgroup -S tradeapi && adduser -S tradeapi -G tradeapi

WORKDIR /app

# Copy the built jar from the builder stage
COPY --from=builder /app/target/sprint-06-trade-api-1.0-SNAPSHOT.jar app.jar

# Own the files as the non-root user
RUN chown tradeapi:tradeapi app.jar

USER tradeapi

# The listening port comes from Application/.env or Config/application.yml; compose publishes it.

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD wget -qO- http://127.0.0.1:${ORDER_SERVICE_PORT}/health || exit 1

ENTRYPOINT ["java", "-jar", "app.jar"]
