# ==============================================================================
# Non-secret settings, given to every pod as environment variables
# (ConfigMap app-config). The LEFT side is the variable name YOUR code reads:
# for another project, rename the keys to what its code reads
# (application.yml ${...}, process.env.X, os.getenv("X")).
# Secrets go in secrets.env, never here: this file is committed.
# ==============================================================================

# ---- Database: RDS ----
DB_HOST=REPLACE_WITH_RDS_ENDPOINT
DB_PORT=5432
DB_NAME=trading_system_db
DB_USER=postgres
PG_SCHEMA=trading
# Node's pg driver: encrypt, without checking the RDS certificate (RDS refuses
# unencrypted connections). The Java driver encrypts on its own.
PGSSLMODE=no-verify

# ---- Kafka: the broker in kafka.yaml ----
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
# Topics the kafka-topics Job creates: name:partitions:retention-ms
KAFKA_TOPICS=orders:3:604800000 trade-events:3:2592000000 market-data:6:86400000 orders.DLT:3:604800000 trade-events.DLT:3:2592000000 market-data.DLT:6:86400000

# ---- The project's shared config file, mounted from ConfigMap shared-config ----
SHARED_CONFIG=/config/application.yml

# ---- Ports the services listen on (this project reads these names) ----
AUTH_SERVICE_PORT=3000
ORDER_SERVICE_PORT=8081
EXECUTOR_SERVICE_PORT=8082
# Automated orders are placed through the order API: the pod itself.
STRATEGY_TRADE_API_URL=http://localhost:8081

# ---- What the BROWSER calls (frontend's app-config.js) ----
# 1-four-elb: set by deploy/set-urls.sh to the two load balancers.
# 2-ingress and 3-cloudfront: empty = same address as the page.
BROWSER_AUTH_URL=
BROWSER_ORDER_URL=

# ---- Which page addresses may call the APIs with cookies (CORS) ----
# Comma separated, exact origins (scheme://host[:port]), no "*": the services
# send cookies, and browsers refuse "*" with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:4200
FRONTEND_URL=http://localhost:4200

# ---- Login cookie ----
# false while the site is plain http (load balancers); true once it is https (CloudFront).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
JWT_ISSUER=auth-service

# ---- External APIs (keys are in secrets.env) ----
FAUXNANCE_BASE_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com/v1
POLL_INTERVAL_SECONDS=60

# ---- Email: empty SMTP_HOST = codes are written to the auth-service log ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=
