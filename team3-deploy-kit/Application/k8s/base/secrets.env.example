# ==============================================================================
# Secrets, given to the application pods as environment variables
# (Secret app-secrets).
#
#   cp secrets.env.example secrets.env     then fill in the values
#
# secrets.env is in .gitignore: NEVER commit it. Names on the left are the
# names YOUR code reads; rename them for another project.
# ==============================================================================
DB_PASSWORD=
# At least 32 bytes, the same for the auth and order services:
#   openssl rand -base64 48
JWT_SECRET=
FAUXNANCE_API_KEY=
SMTP_PASS=
GROQ_API_KEY=
