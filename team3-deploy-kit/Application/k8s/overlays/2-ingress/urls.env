# Same address as the page: nothing to fill in for the app to work.
BROWSER_AUTH_URL=
BROWSER_ORDER_URL=
# The ALB address, written by `deploy/set-urls.sh ingress` (only needed if a
# browser sends a cross-origin request, e.g. from a CloudFront address).
CORS_ALLOWED_ORIGINS=http://pending
FRONTEND_URL=http://pending
COOKIE_SECURE=false
