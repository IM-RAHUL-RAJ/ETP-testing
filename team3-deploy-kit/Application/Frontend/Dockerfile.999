# ---- Build: the same `npm ci && npm run build` a clean machine runs ----
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY angular.json tsconfig*.json openapitools.json ./
COPY src ./src
COPY generated ./generated
COPY scripts ./scripts

# The API addresses the browser calls, fixed into the bundle at build time. docker
# compose passes them from Application/.env (AUTH_SERVICE_URL, ORDER_SERVICE_URL).
ARG AUTH_SERVICE_URL
ARG ORDER_SERVICE_URL
RUN node scripts/sync-config.mjs --print
RUN npx ng build

# ---- Serve the static bundle ----
FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/trading-app-ui/browser /usr/share/nginx/html
EXPOSE 80
