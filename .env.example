# ==============================================================================
# Sprint 8 docker-compose configuration. Copy to .env and adjust as needed;
# every value here has a working default baked into docker-compose.yml, so
# `docker compose up --build` works even without a .env file.
# ==============================================================================

# PostgreSQL (shared trading_system_db, schemas: auth + trading)
DB_NAME=trading_system_db
DB_USER=postgres
DB_PASSWORD=postgres

# Kafka (compose maps container 9092 -> host 9092; containers use kafka:29092)
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# JWT — MUST be identical between auth-service and trade-api.
JWT_SECRET=akatsuki_akatsuki_akatsuki_akatsuki_akatsuki
JWT_ISSUER=auth-service
JWT_TTL_SECONDS=900
REFRESH_TTL_SECONDS=604800

# Auth service login throttle + refresh cookie
THROTTLE_MAX_ATTEMPTS=5
THROTTLE_WINDOW_MS=900000
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Fauxnance API & Poller (executor)
FAUXNANCE_API_KEY=replace_with_fauxnance_api_key
FAUXNANCE_BASE_URL=http://localhost:8080
POLL_INTERVAL_SECONDS=60

# DuckDB Analytics ETL (executor spawns this; frontend reads the same file)
ETL_ENABLED=true
ETL_REFRESH_INTERVAL_SECONDS=45

# Frontend
FLASK_ENV=development
# URLs the BROWSER uses to reach auth-service and trade-api. The localhost
# defaults only work through an SSH/SSM tunnel. To browse the box by public IP
# over plain http, set all four (and open 4200/3000/8085 in the security group):
#   AUTH_URL=http://<public-ip>:3000
#   BACKEND_URL=http://<public-ip>:8085
#   CORS_ALLOWED_ORIGINS=http://<public-ip>:4200
#   COOKIE_SECURE=false   (browsers drop Secure cookies over http off localhost)
AUTH_URL=http://localhost:3000
BACKEND_URL=http://localhost:8085
CORS_ALLOWED_ORIGINS=http://127.0.0.1:4200,http://localhost:4200,http://frontend:4200
DASHBOARD_REFRESH_SECONDS=120
